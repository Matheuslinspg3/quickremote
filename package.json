{
  "name": "quickremote",
  "version": "1.0.0",
  "description": "Sistema de desktop remoto open source rápido e leve",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "server": "node src/server.js",
    "client": "node src/client.js",
    "host": "node src/host.js",
    "host-web": "node src/host-web.js",
    "host-demo": "node src/host-demo.js",
    "start": "node src/railway-server.js",
    "railway": "node src/railway-server.js",
    "deploy-worker": "wrangler deploy",
    "deploy-web": "wrangler pages deploy web --project-name=quickremote-web",
    "dev-worker": "wrangler dev"
  },
  "keywords": ["remote-desktop", "screen-sharing", "remote-control"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.16.0"
  },
  "optionalDependencies": {
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.33.2",
    "robotjs": "^0.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
